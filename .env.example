# Configuration is public. Never put secrets in site.yaml or the browser bundle.
BASE_PATH=/
# NODE_ENV=production

# Encrypted export only: provide ENCRYPTION_PASSPHRASE via a hidden prompt
# or a CI secret. It is never included in the normal frontend build.
# Pages publishing defaults to encrypted; no mode variable is needed.
# PROTOTYPE_PUBLISH_MODE=static explicitly opts into public plaintext publishing.
